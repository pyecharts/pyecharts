#!/usr/bin/env bash
# ============================================================
# pyecharts — Harness Configuration
# ============================================================

# ── Python & Build ──────────────────────────────────────────
PYTHON_MIN_VERSION="3.7"
BUILD_CMD="uv build"
TEST_CMD="uv run pytest -v --cov-config=pyproject.toml --cov=./ test/"
LINT_CMD="uv run flake8 --exclude=build,images,example,examples,.venv --max-line-length=89 --ignore=F401,F824"

# ── Scoring ─────────────────────────────────────────────────
SCORE_TOTAL=100
SCORE_BUILD=20
SCORE_FUNCTION=30
SCORE_TEST=20
SCORE_ARCH=20
SCORE_QUALITY=10
SCORE_PASS_THRESHOLD=90

# ── Test Thresholds ─────────────────────────────────────────
INCREMENTAL_COVERAGE_MIN=70
MAX_FILE_LINES=500
MAX_FUNCTION_LINES=50

# ── Iteration ───────────────────────────────────────────────
MAX_ITERATE_ROUNDS=3
PREFLIGHT_TIMEOUT=30
EVALUATE_TIMEOUT=300

# ── Paths ───────────────────────────────────────────────────
SRC_DIR="pyecharts"
TEST_DIR="test"
SPRINT_DIR=".harness/sprints"
SCRIPT_DIR=".harness/scripts"
ARTIFACT_DIR=".harness/artifacts"
